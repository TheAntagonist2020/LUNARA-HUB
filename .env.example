# ── LUNARA FILM Hub · local configuration ────────────────────────────────────
# Copy this file to .env:   cp .env.example .env
# Everything below is either free or covered by a subscription you already pay
# for. The app runs fully with ZERO keys set (offline template mode).

# AI provider order.
#   auto     = Claude Code CLI (your Claude subscription) → Gemini free tier →
#              built-in offline templates
#   claude   = force the Claude Code CLI
#   gemini   = force the Gemini API
#   template = force offline templates (no network, no keys)
AI_PROVIDER=auto

# ── Option A · $0 extra: your existing Claude subscription ──────────────────
# Uses the Claude Code CLI in headless mode — billed to the Claude plan you
# already pay for, not per-token API pricing.
# Install:  npm install -g @anthropic-ai/claude-code   then run `claude` once to log in.
# CLAUDE_CLI=claude
# CLAUDE_MODEL=sonnet

# ── Option B · $0: Gemini free tier ─────────────────────────────────────────
# Free API key from https://aistudio.google.com/apikey (rate-limited free tier
# is plenty for personal use).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# ── WordPress journal sync · covered by your WordPress.com plan ─────────────
# Published posts are read over the public REST API — no credentials needed.
WP_SITE=lunarafilm.com
WP_POST_TYPES=review,journal,posts

# ── WordPress media pipeline · featured images from URLs ────────────────────
# Lets the hub download official key art, keep a local backup in media-vault/,
# upload it to your site, and set it as a post's featured image.
# Create the password: wp-admin → Users → Profile → Application Passwords.
# WP_USERNAME=your-wp-admin-username
# WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# MEDIA_VAULT_DIR=./media-vault

# ── Typefully dispatch · free with your Typefully account ───────────────────
# Typefully → Settings → API. The hub speaks API v2 — v1 was switched off on
# 15 June 2026 and older v1 keys don't work with v2, so create a fresh key.
# TYPEFULLY_API_KEY=
# Optional: which social set to post into (default: the first one on the
# account) and which of its connected platforms get the draft
# (default: all of x, threads, bluesky, linkedin, mastodon that are connected).
# TYPEFULLY_SOCIAL_SET_ID=
# TYPEFULLY_PLATFORMS=x,threads,bluesky

# ── Buffer dispatch · Buffer's GraphQL API works on every plan, Free too ────
# Buffer → Settings → API → create a personal key. Posts go to the channel
# queue ("share next" and drafts too) — the hub never publishes instantly.
# BUFFER_API_KEY=
# Optional: comma-separated channel IDs to pre-select (default: every
# connected text channel whose queue isn't paused).
# BUFFER_CHANNEL_IDS=

# ── Newsreel · the movie news wire ──────────────────────────────────────────
# Works with zero keys: trade RSS (Dispatch's roster + THR) and official
# studio YouTube channels for trailers. A free TMDB key adds official key art
# and official trailers to news stories — the same key the site's Lunara
# Database Engine uses works here (themoviedb.org → Settings → API; a v3 key
# or a v4 read-access token).
# TMDB_API_KEY=
# Replace the default sources (comma-separated, "Label|url" or just "url";
# trailer channels are "Label|UCxxxx" YouTube channel IDs):
# NEWS_FEEDS=Variety|https://variety.com/v/film/feed/,Deadline|https://deadline.com/v/film/feed/
# NEWS_TRAILER_CHANNELS=A24|UCuPivVjnfNo4mb3Oog_frZg,NEON|UCpy5dRhZd-JbZP4NsrnLt1w

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
